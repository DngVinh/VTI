NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000/api/v1
# Local development value. Production injects a separately scoped Mongo runtime credential.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_practice
# AI credential is a separate secret; never reuse JWT, SMTP, Mongo, or deploy values.
GEMINI_API_KEY=replace-with-gemini-api-key

# Fail closed: enable only after Product/Legal approval and a reviewed dry run.
RETENTION_MUTATION_ENABLED=false
RETENTION_APPROVAL_ID=

# Comma-separated, exact browser origins. Production requires at least one HTTPS origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Parsed request-body limits (1kb..2mb for JSON, 1kb..512kb for forms)
JSON_BODY_LIMIT=256kb
FORM_BODY_LIMIT=64kb
# Number of trusted reverse-proxy hops (0 when directly exposed)
TRUST_PROXY_HOPS=0

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Password reset OTP (use a distinct random value with at least 32 characters)
PASSWORD_RESET_SECRET=replace-with-password-reset-secret-at-least-32-chars

# Google Identity Services Web OAuth client ID (no client secret is needed)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=no-reply@example.com

# Migration/index and deploy credentials intentionally have no application variables here.
# Keep them in their protected job/environment only; getEnv() rejects them in production.
# QUO-01 - Daily interview quota
DAILY_INTERVIEW_QUOTA=5
QUOTA_TIMEZONE=Asia/Ho_Chi_Minh

# QUO-01 - Technical rate limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000

RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=600000

RATE_LIMIT_CREATE_INTERVIEW_MAX=10
RATE_LIMIT_CREATE_INTERVIEW_WINDOW_MS=600000

RATE_LIMIT_AI_MAX=5
RATE_LIMIT_AI_WINDOW_MS=60000

RATE_LIMIT_SUBMIT_MAX=10
RATE_LIMIT_SUBMIT_WINDOW_MS=60000

RATE_LIMIT_PROGRESS_MAX=30
RATE_LIMIT_PROGRESS_WINDOW_MS=60000

# Question Bank rollout (safe defaults)
QUESTION_BANK_ADMIN_API_ENABLED=false
QUESTION_BANK_ADMIN_UI_ENABLED=false
QUESTION_BANK_REVIEW_FOUR_EYES=true
QUESTION_BANK_AI_TRANSLATION_ENABLED=false
QUESTION_BANK_SEMANTIC_DUPLICATES_ENABLED=false
QUESTION_BANK_EMBEDDING_BACKFILL_ENABLED=false
QUESTION_BANK_AI_PROVIDER=gemini
QUESTION_BANK_AI_MODEL=gemini-2.5-flash
QUESTION_BANK_TRANSLATION_MODEL=gemini-2.5-flash
QUESTION_BANK_EMBEDDING_MODEL=text-embedding-004
QUESTION_BANK_EMBEDDING_DIMENSIONS=768
QUESTION_BANK_AI_TIMEOUT_MS=10000
QUESTION_BANK_AI_MAX_RETRIES=2
QUESTION_BANK_SEMANTIC_THRESHOLD=0.75
QUESTION_BANK_DUPLICATE_TOP_K=10

# Interview question-source rollout (AI_ONLY remains the safe default)
INTERVIEW_QUESTION_BANK_INTEGRATION_ENABLED=false
INTERVIEW_QUESTION_SOURCE_MODE=AI_ONLY
INTERVIEW_QUESTION_COUNT=5
INTERVIEW_QUESTION_BANK_POLICY_VERSION=v1
INTERVIEW_QUESTION_BANK_MIN_AVAILABLE=5
INTERVIEW_QUESTION_BANK_HYBRID_BANK_COUNT=2
INTERVIEW_QUESTION_BANK_SHADOW_TIMEOUT_MS=3000
INTERVIEW_QUESTION_BANK_ALLOW_FALLBACK_TO_AI=true
INTERVIEW_QUESTION_BANK_ROLLOUT_PERCENT=100
INTERVIEW_QUESTION_BANK_ROLLOUT_SALT=qb-rollout-salt
QUESTION_SOURCING_TELEMETRY_ENABLED=true
QUESTION_SOURCING_EVENT_RETENTION_DAYS=90
